    "definitions": {
        "authHandler.LoginRequest": {
            "description": "The request body for user login",
            "type": "object",
            "properties": {
                "password": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "authHandler.LoginResponse": {
            "description": "The response containing the JWT token",
            "type": "object",
            "properties": {
                "token": {
                    "type": "string"
                }
            }
        },
        "authHandler.RegisterRequest": {
            "description": "The request body for user registration",
            "type": "object",
            "properties": {
                "password": {
                    "type": "string"
                },
                "role_id": {
                    "description": "Change role_id to an integer",
                    "type": "integer"
                },
                "username": {
                    "type": "string"
                }
            }
        }
