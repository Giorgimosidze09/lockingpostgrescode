{
    "swagger": "2.0",
    "info": {
        "description": "API for managing accounts with withdrawal, deposit, and exchange operations.",
        "title": "Account Management API",
        "contact": {
            "name": "API Support",
            "url": "http://www.example.com/support",
            "email": "support@example.com"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
